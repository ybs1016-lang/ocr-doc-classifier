<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        eGovFrame Boot 실행환경은 Spring Boot 표준 스타터를 그대로 상속받아 구성합니다.
        (전자정부 표준프레임워크 포털에서 배포하는 egovframe-boot-preset을 parent로
         대체 사용해도 무방하며, 사내 Nexus에 배포되어 있다면 아래 parent를
         egovframework.boot:egovframe-boot-preset 으로 교체하시면 됩니다.)
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>egovframework.example</groupId>
    <artifactId>ocr-doc-classifier</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>ocr-doc-classifier</name>
    <description>eGovFrame Boot + Spring AI(Ollama) 기반 OCR 문서 분류 및 검증 시스템</description>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>1.0.0-M4</spring-ai.version>
        <pdfbox.version>2.0.31</pdfbox.version>
        <tess4j.version>5.6.2</tess4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM: Ollama 스타터 등 버전을 일괄 관리 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web / REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring AI + Ollama (qwen2-vl 등 멀티모달 모델 연동) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-ollama-spring-boot-starter</artifactId>
        </dependency>

        <!-- Apache PDFBox: 문서 구조 파싱 및 텍스트 추출 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- Tess4J: 이미지 기반 스캔 문서 OCR (PDFBox 한계 보완) -->
        <dependency>
            <groupId>net.sourceforge.tess4j</groupId>
            <artifactId>tess4j</artifactId>
            <version>${tess4j.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ocr-doc-classifier</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
